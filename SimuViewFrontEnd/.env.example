# 腾讯云语音合成配置
# 请访问 https://console.cloud.tencent.com/tts 获取密钥

# 腾讯云 SecretId（在访问管理->API密钥管理中获取）
TENCENT_CLOUD_SECRET_ID=your_secret_id

# 腾讯云 SecretKey（在访问管理->API密钥管理中获取）
TENCENT_CLOUD_SECRET_KEY=your_secret_key

# 腾讯云 APP ID（在账号信息中获取）
TENCENT_CLOUD_APP_ID=your_app_id

# 腾讯云 TTS 语音参数配置
# 语速范围：-2到2，0为正常语速
TENCENT_CLOUD_TTS_SPEED=0

# 音量范围：0到10，5为正常音量
TENCENT_CLOUD_TTS_VOLUME=5

# 音调范围：-2到2，0为正常音调
TENCENT_CLOUD_TTS_PITCH=0

# 语音名称（参考腾讯云文档选择可用语音）
# 男声：aizhaoyan, aijiaoning, aihuanying, aiheibao 等
# 女声：aixiaoning, aixiuling, aiqiqi, aijinging 等
TENCENT_CLOUD_TTS_VOICE=aixiuling

# 语言区域
# zh-CN: 中文
# en-US: 英文
TENCENT_CLOUD_TTS_LANGUAGE=zh-CN

# 采样率
# 16000: 16k
# 48000: 48k
TENCENT_CLOUD_TTS_SAMPLE_RATE=16000
